#### Comparison of LDA models with k = 6 and k = 7
# Run after the "Load data" and "LDA" sections of Joint-Analysis.R,
# so that the objects `dtm` and `control_gibbs` already exist.
# Each model takes a few minutes (25,000 Gibbs iterations).
library(tidyverse)
library(tidytext)
library(topicmodels)
# Short document names (e.g., "Doe v. JP Morgan")
short_name <- function(x) {
x %>%
str_remove("^\\d{4}-\\d{2}-\\d{2}-[A-Za-z]+-") %>%
str_remove("-C\\.txt$") %>%
str_replace_all("-", " ")
}
# Summaries of a fitted LDA model
summarise_lda <- function(model) {
k <- model@k
beta  <- tidy(model, matrix = "beta")
gamma <- tidy(model, matrix = "gamma") %>% mutate(document = short_name(document))
# 1. Top 10 most probable words per topic
top_words <- beta %>%
group_by(topic) %>%
slice_max(beta, n = 10) %>%
summarise(top_words = paste(term, collapse = ", "))
# 2. Top 10 distinctive words per topic (log2 ratio vs. mean of the other topics)
exclusive_words <- beta %>%
group_by(term) %>%
filter(sum(beta) > 1e-4) %>%
mutate(
beta_mean_others = (sum(beta) - beta) / (n() - 1),
log_ratio        = log2(beta / (beta_mean_others + 1e-10))
) %>%
group_by(topic) %>%
slice_max(log_ratio, n = 10) %>%
summarise(exclusive_words = paste(term, collapse = ", "))
# 3. Topic proportions per document (theta), one column per topic
theta <- gamma %>%
mutate(gamma = round(gamma, 2)) %>%
pivot_wider(names_from = topic, values_from = gamma, names_prefix = "T") %>%
arrange(document)
# 4. Main document of each topic and its share of the topic
#    (close to 1 = topic belongs to a single document)
main_document <- gamma %>%
group_by(topic) %>%
summarise(
main_document = document[which.max(gamma)],
share_of_main = round(max(gamma) / sum(gamma), 2)
)
# 5. Plot: topic proportions per document
theta_plot <- gamma %>%
mutate(topic = factor(topic, levels = 1:k, labels = paste("Topic", 1:k))) %>%
ggplot(aes(x = gamma, y = document, fill = topic)) +
geom_col(position = "fill", alpha = 0.9) +
scale_fill_brewer(palette = "Set1", name = "Topics") +
theme_minimal(base_size = 12) +
theme(
axis.text.y = element_text(color = "black", face = "bold"),
panel.grid.major.y = element_blank()
) +
labs(
title = paste("k =", k),
x = "Document proportion (theta)",
y = "Documents"
)
list(
topics        = left_join(top_words, exclusive_words, by = "topic") %>%
left_join(main_document, by = "topic"),
theta         = theta,
theta_plot    = theta_plot
)
}
#### Model with k = 6 ----------
lda_6 <- LDA(dtm, k = 6, method = "Gibbs", control = control_gibbs)
res_6 <- summarise_lda(lda_6)
print(res_6$topics, width = Inf)   # top words, distinctive words, main document per topic
print(res_6$theta, width = Inf)    # topic proportions per document
res_6$theta_plot
#### Model with k = 7 ----------
lda_7 <- LDA(dtm, k = 7, method = "Gibbs", control = control_gibbs)
res_7 <- summarise_lda(lda_7)
print(res_7$topics, width = Inf)
print(res_7$theta, width = Inf)
res_7$theta_plot
