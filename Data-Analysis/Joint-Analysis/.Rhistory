word_counts <- text_tidy %>%
count(document, word, sort = TRUE)
# Document-term matrix
dtm <- word_counts %>%
cast_dtm(document = document, term = word, value = n)
# Selection of the number of topics k through perplexity
k_values     <- 2:11
perplexities <- numeric(length(k_values))
for (i in seq_along(k_values)) {
k_current <- k_values[i]
# Fit a quick model for each k
model_temp <- LDA(dtm, k = k_current, method = "Gibbs",
control = list(seed = 1234, iter = 1000, burnin = 500))
# Store the perplexity computed by the package
perplexities[i] <- perplexity(model_temp, dtm)
}
# Elbow plot: perplexity vs. number of topics
par(mfrow = c(1, 1), mar = c(3, 3, 2, 0.5), mgp = c(1.7, 0.7, 0))
plot(k_values, perplexities,
type = "b",
pch  = 21,
col  = "black",
bg   = adjustcolor("darkred", 0.8),
lwd  = 2,
cex  = 1.4,
xlab = "k",
ylab = "Perplexity")
# Additional criteria for k (same definitions as the ldatuning package,
# implemented here because ldatuning is no longer on CRAN)
# Griffiths & Steyvers (2004): harmonic mean of the likelihood (maximize)
metric_griffiths <- function(model) {
ll <- model@logLiks
ll <- ll[-seq_len(floor(length(ll) / 2))]          # drop the first half of the chain
m  <- max(-ll)
-(m + log(mean(exp(-ll - m))))                     # log harmonic mean, computed stably
}
# Cao et al. (2009): mean cosine similarity between topics (minimize)
metric_caojuan <- function(model) {
b <- exp(model@beta)                               # k x V word probabilities
pairs <- combn(nrow(b), 2)
cos_sim <- apply(pairs, 2, function(p) {
x <- b[p[1], ]; y <- b[p[2], ]
sum(x * y) / sqrt(sum(x^2) * sum(y^2))
})
mean(cos_sim)
}
# Arun et al. (2010): symmetric KL divergence between two matrix factorizations (minimize)
metric_arun <- function(model, dtm) {
b   <- exp(model@beta)
cm1 <- svd(b)$d                                    # singular values of the topic-word matrix
len <- slam::row_sums(dtm)                         # document lengths
cm2 <- sort(as.vector(len %*% model@gamma) / max(len), decreasing = TRUE)
sum(cm1 * log(cm1 / cm2)) + sum(cm2 * log(cm2 / cm1))
}
# Deveaud et al. (2014): mean divergence between topics (maximize)
metric_deveaud <- function(model) {
b <- exp(model@beta)
b[b == 0] <- .Machine$double.xmin
k <- nrow(b)
pairs <- combn(k, 2)
div <- apply(pairs, 2, function(p) {
x <- b[p[1], ]; y <- b[p[2], ]
0.5 * sum(x * log(x / y)) + 0.5 * sum(y * log(y / x))
})
sum(div) / (k * (k - 1))
}
k_metrics <- tibble(
k             = k_values,
Griffiths2004 = map_dbl(models_k, metric_griffiths),
CaoJuan2009   = map_dbl(models_k, metric_caojuan),
Arun2010      = map_dbl(models_k, metric_arun, dtm = dtm),
Deveaud2014   = map_dbl(models_k, metric_deveaud)
)
# Griffiths & Steyvers (2004): harmonic mean of the likelihood (maximize)
metric_griffiths <- function(model) {
ll <- model@logLiks
ll <- ll[-seq_len(floor(length(ll) / 2))]          # drop the first half of the chain
m  <- max(-ll)
-(m + log(mean(exp(-ll - m))))                     # log harmonic mean, computed stably
}
# Cao et al. (2009): mean cosine similarity between topics (minimize)
metric_caojuan <- function(model) {
b <- exp(model@beta)                               # k x V word probabilities
pairs <- combn(nrow(b), 2)
cos_sim <- apply(pairs, 2, function(p) {
x <- b[p[1], ]; y <- b[p[2], ]
sum(x * y) / sqrt(sum(x^2) * sum(y^2))
})
mean(cos_sim)
}
# Arun et al. (2010): symmetric KL divergence between two matrix factorizations (minimize)
metric_arun <- function(model, dtm) {
b   <- exp(model@beta)
cm1 <- svd(b)$d                                    # singular values of the topic-word matrix
len <- slam::row_sums(dtm)                         # document lengths
cm2 <- sort(as.vector(len %*% model@gamma) / max(len), decreasing = TRUE)
sum(cm1 * log(cm1 / cm2)) + sum(cm2 * log(cm2 / cm1))
}
# Deveaud et al. (2014): mean divergence between topics (maximize)
metric_deveaud <- function(model) {
b <- exp(model@beta)
b[b == 0] <- .Machine$double.xmin
k <- nrow(b)
pairs <- combn(k, 2)
div <- apply(pairs, 2, function(p) {
x <- b[p[1], ]; y <- b[p[2], ]
0.5 * sum(x * log(x / y)) + 0.5 * sum(y * log(y / x))
})
sum(div) / (k * (k - 1))
}
k_metrics <- tibble(
k             = k_values,
Griffiths2004 = map_dbl(models_k, metric_griffiths),
CaoJuan2009   = map_dbl(models_k, metric_caojuan),
Arun2010      = map_dbl(models_k, metric_arun, dtm = dtm),
Deveaud2014   = map_dbl(models_k, metric_deveaud)
)
#### Joint analysis of the ten court filings:
#### corpus size, LDA, Jaccard index, and Spearman correlation
# 0. Load libraries
library(tidyverse)
library(magrittr)
library(tidytext)
library(topicmodels)
library(scales)
data(stop_words)
#### Load data ----------
# File names of the ten cleaned documents (*-C.txt)
files <- list.files(pattern = "\\.txt$")
# Load all files into a tibble (one row per document)
full_texts <- tibble(
document = files,
text     = map_chr(files, read_file)
)
#### Words per document ----------
words_per_document <- full_texts %>%
unnest_tokens(word, text) %>%                          # one word per row
count(document, name = "total_words") %>%              # all words
left_join(
full_texts %>%
unnest_tokens(word, text) %>%
anti_join(stop_words, by = "word") %>%             # drop stop words
count(document, name = "words_no_stopwords"),
by = "document"
) %>%
arrange(document)
words_per_document
# Corpus total
words_per_document %>%
summarise(across(where(is.numeric), sum))
####### LDA ---------------
# Tokenization (one word per row)
text_tidy <- full_texts %>%
unnest_tokens(input = text, output = word) %>%
filter(!is.na(word))
# Token cleaning: remove tokens containing numbers and stop words
text_tidy %<>%
filter(!grepl(pattern = "[0-9]", x = word))
text_tidy %<>%
anti_join(x = ., y = stop_words, by = "word")
# Word counts by document
word_counts <- text_tidy %>%
count(document, word, sort = TRUE)
# Document-term matrix
dtm <- word_counts %>%
cast_dtm(document = document, term = word, value = n)
# Selection of the number of topics k through perplexity
k_values     <- 2:11
perplexities <- numeric(length(k_values))
models_k     <- vector("list", length(k_values))   # fitted models, reused below
for (i in seq_along(k_values)) {
k_current <- k_values[i]
# Fit a quick model for each k
# (keep = 10 stores the log-likelihood every 10 iterations; it does not change the fit)
model_temp <- LDA(dtm, k = k_current, method = "Gibbs",
control = list(seed = 1234, iter = 1000, burnin = 500, keep = 10))
# Store the perplexity computed by the package
perplexities[i] <- perplexity(model_temp, dtm)
models_k[[i]]   <- model_temp
}
# Elbow plot: perplexity vs. number of topics
par(mfrow = c(1, 1), mar = c(3, 3, 2, 0.5), mgp = c(1.7, 0.7, 0))
plot(k_values, perplexities,
type = "b",
pch  = 21,
col  = "black",
bg   = adjustcolor("darkred", 0.8),
lwd  = 2,
cex  = 1.4,
xlab = "k",
ylab = "Perplexity")
# Additional criteria for k (same definitions as the ldatuning package,
# implemented here because ldatuning is no longer on CRAN)
# Griffiths & Steyvers (2004): harmonic mean of the likelihood (maximize)
metric_griffiths <- function(model) {
ll <- model@logLiks
ll <- ll[-seq_len(floor(length(ll) / 2))]          # drop the first half of the chain
m  <- max(-ll)
-(m + log(mean(exp(-ll - m))))                     # log harmonic mean, computed stably
}
# Cao et al. (2009): mean cosine similarity between topics (minimize)
metric_caojuan <- function(model) {
b <- exp(model@beta)                               # k x V word probabilities
pairs <- combn(nrow(b), 2)
cos_sim <- apply(pairs, 2, function(p) {
x <- b[p[1], ]; y <- b[p[2], ]
sum(x * y) / sqrt(sum(x^2) * sum(y^2))
})
mean(cos_sim)
}
# Arun et al. (2010): symmetric KL divergence between two matrix factorizations (minimize)
metric_arun <- function(model, dtm) {
b   <- exp(model@beta)
cm1 <- svd(b)$d                                    # singular values of the topic-word matrix
len <- slam::row_sums(dtm)                         # document lengths
cm2 <- sort(as.vector(len %*% model@gamma) / max(len), decreasing = TRUE)
sum(cm1 * log(cm1 / cm2)) + sum(cm2 * log(cm2 / cm1))
}
# Deveaud et al. (2014): mean divergence between topics (maximize)
metric_deveaud <- function(model) {
b <- exp(model@beta)
b[b == 0] <- .Machine$double.xmin
k <- nrow(b)
pairs <- combn(k, 2)
div <- apply(pairs, 2, function(p) {
x <- b[p[1], ]; y <- b[p[2], ]
0.5 * sum(x * log(x / y)) + 0.5 * sum(y * log(y / x))
})
sum(div) / (k * (k - 1))
}
k_metrics <- tibble(
k             = k_values,
Griffiths2004 = map_dbl(models_k, metric_griffiths),
CaoJuan2009   = map_dbl(models_k, metric_caojuan),
Arun2010      = map_dbl(models_k, metric_arun, dtm = dtm),
Deveaud2014   = map_dbl(models_k, metric_deveaud)
)
k_metrics
# Plot: each metric rescaled to [0, 1]
k_metrics %>%
pivot_longer(-k, names_to = "metric", values_to = "value") %>%
group_by(metric) %>%
mutate(
value = (value - min(value)) / (max(value) - min(value)),
goal  = if_else(metric %in% c("Griffiths2004", "Deveaud2014"), "Maximize", "Minimize")
) %>%
ungroup() %>%
ggplot(aes(x = k, y = value, color = metric)) +
geom_line(linewidth = 0.8) +
geom_point(size = 2.5) +
facet_wrap(~ goal, ncol = 1) +
scale_x_continuous(breaks = k_values) +
theme_minimal(base_size = 12) +
labs(x = "Number of topics (k)", y = "Rescaled value", color = "Metric")
# Optimal value: k = 6
lda_model <- LDA(dtm, k = 7, method = "Gibbs", control = control_gibbs)
# Gibbs sampler settings
control_gibbs <- list(
seed   = 1234,
burnin = 5000,
iter   = 20000,
keep   = 10      # keep the log-likelihood every 10 iterations
)
lda_model <- LDA(dtm, k = 7, method = "Gibbs", control = control_gibbs)
# Log-likelihood trace (convergence check)
ll <- lda_model@logLiks
par(mfrow = c(1, 1), mar = c(2.75, 3, 1.5, 0.5), mgp = c(1.7, 0.7, 0))
plot(ll[-c(1:10)], type = "p", pch = 16, col = adjustcolor(1, 0.8), cex = 1.2,
xlab = "Iteration", ylab = "Log-likelihood")
# Extract the beta matrix (word probabilities per topic)
topics_beta <- tidy(lda_model, matrix = "beta")
# Top 10 words per topic
top_terms <- topics_beta %>%
group_by(topic) %>%
slice_max(beta, n = 10) %>%
ungroup() %>%
arrange(topic, -beta)
# Bar chart: most probable words per topic
ggplot(top_terms, aes(x = beta,
y = reorder_within(term, beta, topic),
fill = factor(topic))) +
geom_col(show.legend = FALSE) +
facet_wrap(~ paste("Topic", topic), scales = "free_y", ncol = 3) +
scale_y_reordered() +
scale_fill_viridis_d(option = "turbo", alpha = 0.85) +
theme_minimal(base_size = 12) +
theme(
plot.title    = element_text(face = "bold", size = 16),
plot.subtitle = element_text(color = "gray30", margin = margin(b = 15)),
strip.text    = element_text(face = "bold", size = 12),
panel.grid.major.y = element_blank(),   # remove horizontal grid lines
axis.text.y   = element_text(color = "black")
) +
labs(
x = "Probability (beta)",
y = NULL
)
# Distinctive terms per topic: log2 ratio between the topic and the mean of the other topics
exclusive_terms <- topics_beta %>%
group_by(term) %>%
filter(sum(beta) > 1e-4) %>%
mutate(
beta_mean_others = (sum(beta) - beta) / (n() - 1),
log_ratio        = log2(beta / (beta_mean_others + 1e-10))
) %>%
ungroup() %>%
group_by(topic) %>%
slice_max(log_ratio, n = 10) %>%
ungroup() %>%
arrange(topic, -log_ratio)
# Bar chart: distinctive terms per topic
ggplot(exclusive_terms, aes(x = log_ratio,
y = reorder_within(term, log_ratio, topic),
fill = factor(topic))) +
geom_col(show.legend = FALSE) +
facet_wrap(~ paste("Topic", topic), scales = "free_y", ncol = 3) +
scale_y_reordered() +
scale_fill_viridis_d(option = "plasma", alpha = 0.85) +
theme_minimal(base_size = 12) +
theme(
plot.title    = element_text(face = "bold", size = 16),
plot.subtitle = element_text(color = "gray30", margin = margin(b = 15)),
strip.text    = element_text(face = "bold", size = 12),
panel.grid.major.y = element_blank(),
axis.text.y   = element_text(color = "black")
) +
labs(
x = "Exclusivity (log2 ratio)",
y = NULL
)
# Theta: topic proportions of each document
doc_theta <- tidy(lda_model, matrix = "gamma") %>%
mutate(
topic    = factor(topic, levels = 1:6, labels = paste("Topic", 1:6)),
document = document %>%
str_remove("^\\d{4}-\\d{2}-\\d{2}-[A-Za-z]+-") %>%   # remove date and document type
str_remove("-C\\.txt$") %>%
str_replace_all("-", " ")
)
# Stacked bar chart: topic proportions per document
ggplot(doc_theta, aes(x = gamma, y = document, fill = topic)) +
geom_col(position = "fill", alpha = 0.9) +
scale_fill_brewer(palette = "Set1", name = "Topics") +
theme_minimal(base_size = 12) +
theme(
plot.title    = element_text(face = "bold", size = 16),
plot.subtitle = element_text(color = "gray30", margin = margin(b = 15)),
axis.text.y   = element_text(color = "black", face = "bold"),
panel.grid.major.y = element_blank()
) +
labs(
x = "Document proportion (theta)",
y = "Documents"
)
tidy(lda_model_7, matrix = "gamma") %>%
group_by(topic) %>%
summarise(
main_document = document[which.max(gamma)],
share_of_main = max(gamma) / sum(gamma)   # close to 1 = topic belongs to a single document
) %>%
arrange(desc(share_of_main))
tidy(lda_model, matrix = "gamma") %>%
group_by(topic) %>%
summarise(
main_document = document[which.max(gamma)],
share_of_main = max(gamma) / sum(gamma)   # close to 1 = topic belongs to a single document
) %>%
arrange(desc(share_of_main))
# 1. Top 10 words per topic
tidy(lda_model_7, matrix = "beta") %>%
group_by(topic) %>%
slice_max(beta, n = 10) %>%
summarise(top_words = paste(term, collapse = ", "))
# 2. Topic proportions per document (one column per topic)
tidy(lda_model_7, matrix = "gamma") %>%
mutate(
document = document %>%
str_remove("^\\d{4}-\\d{2}-\\d{2}-[A-Za-z]+-") %>%
str_remove("-C\\.txt$"),
gamma = round(gamma, 2)
) %>%
pivot_wider(names_from = topic, values_from = gamma, names_prefix = "T")
# 1. Top 10 words per topic
tidy(lda_model, matrix = "beta") %>%
group_by(topic) %>%
slice_max(beta, n = 10) %>%
summarise(top_words = paste(term, collapse = ", "))
# 2. Topic proportions per document (one column per topic)
tidy(lda_model, matrix = "gamma") %>%
mutate(
document = document %>%
str_remove("^\\d{4}-\\d{2}-\\d{2}-[A-Za-z]+-") %>%
str_remove("-C\\.txt$"),
gamma = round(gamma, 2)
) %>%
pivot_wider(names_from = topic, values_from = gamma, names_prefix = "T")
# Distinctive terms per topic: log2 ratio between the topic and the mean of the other topics
exclusive_terms <- topics_beta %>%
group_by(term) %>%
filter(sum(beta) > 1e-4) %>%
mutate(
beta_mean_others = (sum(beta) - beta) / (n() - 1),
log_ratio        = log2(beta / (beta_mean_others + 1e-10))
) %>%
ungroup() %>%
group_by(topic) %>%
slice_max(log_ratio, n = 10) %>%
ungroup() %>%
arrange(topic, -log_ratio)
# Bar chart: distinctive terms per topic
ggplot(exclusive_terms, aes(x = log_ratio,
y = reorder_within(term, log_ratio, topic),
fill = factor(topic))) +
geom_col(show.legend = FALSE) +
facet_wrap(~ paste("Topic", topic), scales = "free_y", ncol = 3) +
scale_y_reordered() +
scale_fill_viridis_d(option = "plasma", alpha = 0.85) +
