## Data cleaning: 2022-11-24-Complaint-Doe-v.-JP-Morgan
# 0. Load libraries
library(tidyverse)
library(readr)
library(pdftools)
# 1. Read the PDF file
raw_text <- pdf_text("gov.uscourts.nysd.590048.1.0_4.pdf")
# 2. Remove the last two pages
raw_text <- raw_text[1:73]
# 3. Join all pages into a single text
raw_text <- paste(raw_text, collapse = "\n")
# 4. Save the raw text as a .txt file
write_file(raw_text, "2022-11-24-Complaint-Doe-v.-JP-Morgan.txt")
# 5. Load the .txt file
raw_text <- read_file("2022-11-24-Complaint-Doe-v.-JP-Morgan.txt")
# 6. Clean the text using regular expressions (regex)
text_clean <- raw_text %>%
# Remove page headers with their original spacing
# (e.g., "Case 1:22-cv-10019-JSR      Document 1    Filed 11/24/22   Page 2 of 75")
str_remove_all("Case 1:22-cv-10019-JSR      Document 1    Filed 11/24/22   Page [0-9]+ of 75") %>%
# Replace line breaks with a space
str_replace_all("\n", " ") %>%
# Remove extra whitespace
str_squish() %>%
# Remove the remaining page headers, whose spacing differs from the pattern above
# and which are only matched once extra whitespace has been removed
str_remove_all("Case 1:22-cv-10019-JSR Document 1 Filed 11/24/22 Page [0-9]+ of 75")
# 7. Save the cleaned text as a .txt file
write_file(text_clean, "2022-11-24-Complaint-Doe-v.-JP-Morgan-C.txt")
